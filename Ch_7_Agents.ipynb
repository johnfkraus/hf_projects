    "from transformers.agents import FinalAnswerTool\n",
    "final_answer = FinalAnswerTool()\n",
    "\n",
    "agent = ReactJsonAgent(tools=[final_answer])\n",
    "response = agent.run(\"What is list comprehension\")\n",
    "print(response)"
   ]
