    "from transformers.agents import TranslationTool\n",
    "translation = TranslationTool()\n",
    "\n",
    "agent = ReactJsonAgent(tools=[translation])\n",
    "\n",
    "response = agent.run(\"What is list comprehension\", tgt_lang='Spanish')\n",
    "print(response)"
   ]
  },
